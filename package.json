{
  "name": "ros2-foxglove-panel",
  "version": "0.1.0",
  "description": "Zero-install web control panel for ROS 2 — connects directly to foxglove_bridge (topics, services, parameters, actions, TF). No roslibjs, no rosbridge, no ROS installation.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "ros2",
    "foxglove",
    "foxglove-bridge",
    "websocket",
    "cdr",
    "robotics",
    "visualization"
  ],
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "cli": "node cli.mjs",
    "doctor": "node tools/doctor.mjs",
    "test": "node tools/check-url.mjs && node tools/test-grouping.mjs && node tools/e2e.mjs && node tools/check-grouping-ui.mjs",
    "test:offline": "node tools/check-url.mjs && node tools/test-grouping.mjs",
    "test:e2e": "node tools/e2e.mjs",
    "test:grouping": "node tools/check-grouping-ui.mjs && node tools/test-grouping.mjs"
  },
  "dependencies": {
    "@foxglove/rosmsg": "^5.0.0",
    "@foxglove/rosmsg2-serialization": "^3.0.0",
    "foxglove-ros-adapter": "^0.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jsdom": "^30.1.0",
    "vite": "^5.4.10",
    "ws": "^8.21.3"
  }
}
