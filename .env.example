# 复制为 .env.local 后按需修改（.env.local 已在 .gitignore 里）

# 默认连接的 foxglove_bridge 地址。
# 不设置时用代码里的默认值 ws://192.168.16.179:8765。
# 换部署环境时在这里覆盖，不用改源码。
# VITE_ROS_BRIDGE_URL=ws://10.0.0.7:8765

# 供 tools/ 下的排查脚本与自动化测试使用（Node 侧读取，不带 VITE_ 前缀）
# 不设置时同样默认 ws://192.168.16.179:8765
# ROS_BRIDGE_URL=ws://10.0.0.7:8765
