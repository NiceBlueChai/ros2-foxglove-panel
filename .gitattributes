# 默认按文本处理并归一化为 LF（仓库内一律 LF，检出时 Windows 自动转 CRLF）
* text=auto eol=lf

# 显式声明文本文件
*.js    text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# 二进制文件不要动
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.woff  binary
*.woff2 binary

# package-lock.json 由 npm 生成，避免 merge 冲突时污染 diff
package-lock.json  -diff linguist-generated
